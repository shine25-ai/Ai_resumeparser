# --- LLM provider (groq | openrouter | ollama); the backend's Settings page can override these per request
LLM_PROVIDER=groq
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
OPENROUTER_API_KEY=
OLLAMA_BASE_URL=
PARSE_MODE=single            # single = 1 call per resume (auto-repairs dropped sections), multi = 1 call per section

# --- Limits per LLM call
LLM_TIMEOUT_SECONDS=180
LLM_MAX_TOKENS=16384         # applied to openrouter/ollama; for groq only when set explicitly

# --- Rate limits and queue (gap G04)
LLM_RATE_LIMIT_RETRIES=5             # waits on 429 before giving up
LLM_RATE_LIMIT_MAX_WAIT_SECONDS=90   # a longer requested wait (or a daily limit) fails at once
PARSER_MAX_CONCURRENT_JOBS=2         # resumes parsed at the same time; the rest wait as "queued"

# --- Text extraction (gaps G06-G08)
# OCR for scanned PDFs needs Tesseract:  apt-get install tesseract-ocr   (macOS: brew install tesseract)
OCR_ENABLED=true
OCR_LANGUAGE=eng
MIN_TEXT_CHARS=100                   # fewer letters/digits than this = "no readable text"
MIN_VISIBLE_FONT=4.5                 # pt; smaller PDF text is treated as hidden and removed
# Legacy .doc needs LibreOffice:  apt-get install libreoffice-writer   (or set the path below)
SOFFICE_PATH=
SOFFICE_TIMEOUT_SECONDS=90
